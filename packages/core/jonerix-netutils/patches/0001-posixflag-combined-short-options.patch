index 0000000..82563a4
--- /dev/null
+++ b/pkg/posixflag/posixflag_test.go
@@ -0,0 +1,68 @@
+// Copyright (C) 2026 Jon-Erik G. Storm, Inc., a California Corporation,
+// doing business as LAVA GOAT SOFTWARE.
+//
+// SPDX-License-Identifier: MIT
+
+package posixflag
+
+import (
+	"flag"
+	"io"
+	"reflect"
+	"testing"
+)
+
+func TestArgs(t *testing.T) {
+	fs := flag.NewFlagSet("t", flag.ContinueOnError)
+	fs.Bool("t", false, "")
+	fs.Bool("l", false, "")
+	fs.Bool("n", false, "")
+	fs.Bool("p", false, "")
+	fs.Bool("br", false, "")
+	fs.Bool("inet6", false, "")
+	fs.String("I", "", "")
+	fs.Int("c", 0, "")
+
+	for _, tc := range []struct {
+		in, want []string
+	}{
+		{[]string{"-tlnp"}, []string{"-t", "-l", "-n", "-p"}},
+		{[]string{"-ltn", "-p"}, []string{"-l", "-t", "-n", "-p"}},
+		{[]string{"-c3", "host"}, []string{"-c", "3", "host"}},
+		{[]string{"-nc", "3", "host"}, []string{"-n", "-c", "3", "host"}},
+		{[]string{"-Ieth0", "-n"}, []string{"-I", "eth0", "-n"}},
+		{[]string{"-I", "-weird", "-n"}, []string{"-I", "-weird", "-n"}},
+		{[]string{"-I=eth0"}, []string{"-I=eth0"}},
+		{[]string{"-c=3", "-t=false"}, []string{"-c=3", "-t=false"}},
+		{[]string{"-nc=3"}, []string{"-n", "-c", "3"}},
+		{[]string{"-br", "addr"}, []string{"-br", "addr"}},
+		{[]string{"-inet6"}, []string{"-inet6"}},
+		{[]string{"--inet6", "--tcp"}, []string{"-inet6", "-tcp"}},
+		{[]string{"-t", "--", "-l"}, []string{"-t", "--", "-l"}},
+		{[]string{"-t", "host", "-l"}, []string{"-t", "host", "-l"}},
+		{[]string{"-tz"}, []string{"-t", "-z"}},
+		{[]string{"-"}, []string{"-"}},
+	} {
+		if got := Args(fs, tc.in); !reflect.DeepEqual(got, tc.want) {
+			t.Errorf("Args(%q) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
+
+func TestParse(t *testing.T) {
+	fs := flag.NewFlagSet("t", flag.ContinueOnError)
+	fs.SetOutput(io.Discard)
+	tf := fs.Bool("t", false, "")
+	lf := fs.Bool("l", false, "")
+	cf := fs.Int("c", 0, "")
+	iface := fs.String("I", "", "")
+	if err := Parse(fs, []string{"-tl", "-c=3", "-Ieth0", "host", "-x"}); err != nil {
+		t.Fatal(err)
+	}
+	if !*tf || !*lf || *cf != 3 || *iface != "eth0" || !reflect.DeepEqual(fs.Args(), []string{"host", "-x"}) {
+		t.Errorf("t=%v l=%v c=%d I=%q args=%q", *tf, *lf, *cf, *iface, fs.Args())
+	}
+	if err := Parse(fs, []string{"-tq"}); err == nil {
+		t.Errorf("unknown letter in a cluster was accepted")
+	}
+}
