diff --git a/pkg/posixflag/posixflag.go b/pkg/posixflag/posixflag.go
new file mode 100644
index 0000000..7181630
--- /dev/null
+++ b/pkg/posixflag/posixflag.go
@@ -0,0 +1,87 @@
+// Copyright (C) 2026 Jon-Erik G. Storm, Inc., a California Corporation,
+// doing business as LAVA GOAT SOFTWARE.
+//
+// SPDX-License-Identifier: MIT
+
+// Package posixflag rewrites a POSIX/getopt-style command line into the
+// form Go's flag package understands, using the FlagSet itself to know
+// which single-letter options take a value.
+//
+//   - Clustered short options are split: -tlnp becomes -t -l -n -p.
+//   - A value-taking letter ends the cluster; the rest of the cluster is
+//     its value (-c3 becomes -c 3, -Ieth0 becomes -I eth0). With nothing
+//     left in the cluster, the next argument is its value, verbatim.
+//   - A single-dash word that names a defined multi-letter flag (Go style,
+//     e.g. -inet6, -br, -numeric=true) passes through unchanged, and so
+//     does a defined flag of any length given with =VALUE (iproute2's
+//     -c=auto, Go's -t=false).
+//   - --long[=value] becomes -long[=value].
+//   - Parsing stops at "--", at "-", and at the first operand; the rest is
+//     passed through unchanged, as POSIX getopt does.
+//
+// Unknown letters are passed through as -X so flag.Parse reports them.
+package posixflag
+
+import (
+	"flag"
+	"strings"
+)
+
+type boolFlag interface {
+	IsBoolFlag() bool
+}
+
+func takesValue(f *flag.Flag) bool {
+	if bf, ok := f.Value.(boolFlag); ok && bf.IsBoolFlag() {
+		return false
+	}
+	return true
+}
+
+// Args converts args (without the program name) for fs.Parse.
+func Args(fs *flag.FlagSet, args []string) []string {
+	out := make([]string, 0, len(args))
+	for i := 0; i < len(args); i++ {
+		a := args[i]
+		if a == "--" || a == "-" || !strings.HasPrefix(a, "-") {
+			return append(out, args[i:]...)
+		}
+		if strings.HasPrefix(a, "--") {
+			out = append(out, a[1:])
+			continue
+		}
+		name := a[1:]
+		hasValue := false
+		if k := strings.IndexByte(name, '='); k >= 0 {
+			name, hasValue = name[:k], true
+		}
+		if (len(name) > 1 || hasValue) && fs.Lookup(name) != nil {
+			out = append(out, a)
+			continue
+		}
+		body := []rune(a[1:])
+		for j, r := range body {
+			c := string(r)
+			f := fs.Lookup(c)
+			if f == nil || !takesValue(f) {
+				out = append(out, "-"+c)
+				continue
+			}
+			out = append(out, "-"+c)
+			if rest := string(body[j+1:]); rest != "" {
+				out = append(out, strings.TrimPrefix(rest, "="))
+			} else if i+1 < len(args) {
+				i++
+				out = append(out, args[i])
+			}
+			break
+		}
+	}
+	return out
+}
+
+// Parse parses args (without the program name) into fs after rewriting
+// them with Args.
+func Parse(fs *flag.FlagSet, args []string) error {
+	return fs.Parse(Args(fs, args))
+}
