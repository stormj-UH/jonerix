+
+package netstat
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// fakeProc builds a /proc-like tree: one directory per pid with cmdline,
+// comm and fd/<n> symlinks.
+func fakeProc(t *testing.T) string {
+	t.Helper()
+	root := t.TempDir()
+	mk := func(pid, cmdline, comm string, fds map[string]string) {
+		dir := filepath.Join(root, pid)
+		if err := os.MkdirAll(filepath.Join(dir, "fd"), 0o755); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "cmdline"), []byte(cmdline), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "comm"), []byte(comm+"\n"), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		for fd, target := range fds {
+			if err := os.Symlink(target, filepath.Join(dir, "fd", fd)); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	// Later arguments contain slashes; the name is argv[0]'s base name.
+	mk("2453", "/bin/dropbear\x00-R\x00-P\x00/run/dropbear.pid\x00", "dropbear",
+		map[string]string{"0": "/dev/null", "3": "socket:[101]"})
+	// The socket sits on fd 25, above a gap in the fd numbers.
+	mk("2043", "/usr/sbin/tailscaled\x00--socket=/run/tailscale/tailscaled.sock\x00", "tailscaled",
+		map[string]string{"0": "/dev/null", "1": "/dev/null", "25": "socket:[102]"})
+	// A kernel thread has no cmdline: the name comes from comm.
+	mk("7", "", "kworker/0:1", map[string]string{"4": "socket:[103]"})
+	// Names are cut to 20 characters.
+	mk("99", "/opt/averyveryverylongprogramname\x00", "x", map[string]string{"5": "socket:[104]"})
+	// A process that exited mid-scan (no fd directory) is skipped, and
+	// entries that are not pids are ignored.
+	for _, d := range []string{"1234", "net"} {
+		if err := os.MkdirAll(filepath.Join(root, d), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := os.WriteFile(filepath.Join(root, "uptime"), []byte("1 1\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	return root
+}
+
+func TestReadProgFS(t *testing.T) {
+	old := procFS
+	procFS = fakeProc(t)
+	defer func() { procFS = old }()
+
+	got, _, err := readProgFS()
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[int]ProcNode{
+		101: {Name: "dropbear", PID: 2453, Inode: 101},
+		102: {Name: "tailscaled", PID: 2043, Inode: 102},
+		103: {Name: "kworker/0:1", PID: 7, Inode: 103},
+		104: {Name: "averyveryverylongpro", PID: 99, Inode: 104},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("readProgFS() = %v, want %v", got, want)
+	}
+}
+
+func TestDatagramListening(t *testing.T) {
+	unconnected := netSocket{
+		Protocol:    PROT_UDP,
+		LocalAddr:   IPAddress{Address: net.IPv4(0, 0, 0, 0).To4(), Port: 68},
+		ForeignAddr: IPAddress{Address: net.IPv4(0, 0, 0, 0).To4()},
+		State:       7,
+	}
+	connected := netSocket{
+		Protocol:    PROT_UDP,
+		LocalAddr:   IPAddress{Address: net.IPv4(10, 0, 0, 8).To4(), Port: 41641},
+		ForeignAddr: IPAddress{Address: net.IPv4(10, 0, 0, 1).To4(), Port: 53},
+		State:       1,
+	}
+	n := &NetSockets{Protocol: PROT_UDP, Entries: []netSocket{unconnected, connected}}
+
+	for _, tc := range []struct {
+		lst, all bool
+		want     []string
+	}{
+		{lst: true, want: []string{"0.0.0.0:68"}},
+		{want: []string{"10.0.0.8:41641"}},
+		{all: true, want: []string{"0.0.0.0:68", "10.0.0.8:41641"}},
+	} {
+		o := &Output{FmtFlags: FmtFlags{NumHosts: true, NumPorts: true}, Listening: tc.lst, All: tc.all}
+		out, err := n.SocketsString(tc.lst, tc.all, o)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var locals []string
+		for _, line := range strings.Split(out, "\n") {
+			if f := strings.Fields(line); len(f) > 3 && f[0] == "udp" {
+				locals = append(locals, f[3])
+			}
+		}
+		if !reflect.DeepEqual(locals, tc.want) {
+			t.Errorf("lst=%v all=%v: listed %v, want %v\n%s", tc.lst, tc.all, locals, tc.want, out)
+		}
+		if tc.lst && !strings.Contains(out, "0.0.0.0:*") {
+			t.Errorf("unconnected peer should print as 0.0.0.0:*\n%s", out)
+		}
+	}
+}
