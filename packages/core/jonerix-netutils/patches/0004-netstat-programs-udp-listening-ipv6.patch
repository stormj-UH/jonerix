+// datagramString lists UDP, UDPLite and RAW sockets, which have no LISTEN
+// state. As in net-tools, a socket with no remote address (0.0.0.0:0 or
+// [::]:0, i.e. unconnected) counts as listening: -l shows only those, the
+// default shows only connected ones, and -a shows both.
+func (n *NetSockets) datagramString(lst, all bool, outputfmt *Output) (string, error) {
+	outputfmt.InitIPSocketTitels()
