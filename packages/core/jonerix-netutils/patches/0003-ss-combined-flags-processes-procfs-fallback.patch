+func TestProcUnix(t *testing.T) {
+	body := "Num       RefCount Protocol Flags    Type St Inode Path\n" +
+		"0000000000000000: 00000002 00000000 00010000 0001 01 101 /run/dropbear.sock\n" +
+		"0000000000000000: 00000002 00000000 00000000 0002 01 102 /dev/log\n" +
+		"0000000000000000: 00000003 00000000 00000000 0001 03 103 @abstract\n" +
+		"0000000000000000: 00000003 00000000 00000000 0005 03 104\n"
+	socks, err := procUnix(writeFile(t, "unix", body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &printer{o: &options{}}
+	want := [][3]string{
+		{"u_str", "LISTEN", "/run/dropbear.sock 101"},
+		{"u_dgr", "UNCONN", "/dev/log 102"},
+		{"u_str", "ESTAB", "@abstract 103"},
+		{"u_seq", "ESTAB", "* 104"},
+	}
+	if len(socks) != len(want) {
+		t.Fatalf("got %d sockets, want %d", len(socks), len(want))
+	}
+	for i, w := range want {
+		got := p.row(&socks[i])
+		if got[0] != w[0] || got[1] != w[1] || got[4] != w[2] {
+			t.Errorf("row %d = %q, want %q", i, got, w)
+		}
+	}
+	listen := &options{listen: true}
+	if !wanted(listen, &socks[0]) || !wanted(listen, &socks[1]) || wanted(listen, &socks[2]) {
+		t.Errorf("-l must keep the listener and the bound datagram socket only")
+	}
+}
