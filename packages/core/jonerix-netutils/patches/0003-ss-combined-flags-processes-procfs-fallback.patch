+const inetHeader = "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\n"
+
+func TestProcInetUDP(t *testing.T) {
+	body := inetHeader +
+		fmt.Sprintf("  1: %s %s 07 00000000:00000000 00:00000000 00000000     0        0 4711 2 0000000000000000 0\n",
+			hexAddr(net.IPv4zero, 68), hexAddr(net.IPv4zero, 0)) +
+		fmt.Sprintf("  2: %s %s 01 00000010:00000020 00:00000000 00000000  1000        0 4712 2 0000000000000000 0\n",
+			hexAddr(net.ParseIP("10.0.0.8"), 41641), hexAddr(net.ParseIP("10.0.0.1"), 53))
+	socks, err := procInet(writeFile(t, "udp", body), "udp", unix.AF_INET)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(socks) != 2 {
+		t.Fatalf("got %d sockets, want 2", len(socks))
+	}
+	p := &printer{o: &options{numeric: true}}
+	if got := p.row(&socks[0]); got[1] != "UNCONN" || got[4] != "0.0.0.0:68" || got[5] != "0.0.0.0:*" {
+		t.Errorf("unconnected row = %q", got)
+	}
+	s := socks[1]
+	if got := p.row(&s); got[1] != "ESTAB" || got[4] != "10.0.0.8:41641" || got[5] != "10.0.0.1:53" {
+		t.Errorf("connected row = %q", got)
+	}
+	if s.sendQ != 0x10 || s.recvQ != 0x20 || s.uid != 1000 || s.inode != 4712 {
+		t.Errorf("queues/uid/inode = %d/%d/%d/%d", s.sendQ, s.recvQ, s.uid, s.inode)
+	}
+
+	listen := &options{listen: true}
+	if !wanted(listen, &socks[0]) || wanted(listen, &socks[1]) {
+		t.Errorf("-l must keep only the unconnected socket")
+	}
+	if wanted(&options{}, &socks[0]) || !wanted(&options{}, &socks[1]) {
+		t.Errorf("default must keep only the connected socket")
+	}
+}
