+func TestServices(t *testing.T) {
+	svc := loadServices(writeFile(t, "services", "# comment\nssh\t\t22/tcp\ndomain\t53/tcp\ndomain\t53/udp  # DNS\nbootpc 68/udp\n"))
+	p := &printer{o: &options{}, services: svc}
+	if got := p.port("tcp", 22); got != "ssh" {
+		t.Errorf("tcp/22 = %s", got)
+	}
+	if got := p.port("udp", 68); got != "bootpc" {
+		t.Errorf("udp/68 = %s", got)
+	}
+	if got := p.port("udp", 22); got != "22" {
+		t.Errorf("udp/22 = %s", got)
