+	if got := p.port("tcp", 0); got != "*" {
+		t.Errorf("port 0 = %s", got)
+	}
+	p.o.numeric = true
+	if got := p.port("tcp", 22); got != "22" {
+		t.Errorf("-n tcp/22 = %s", got)
