+		if ip == nil {
+			ip = net.IPv6unspecified
+		}
+		host = "[" + ip.String() + "]"
+	default:
+		if ip == nil {
+			ip = net.IPv4zero
+		}
+		host = ip.To4().String()
+	}
+	return host + ":" + p.port(s.netid, port)
+}
+
+func (p *printer) row(s *sock) []string {
+	var local, peer string
+	if s.family == unix.AF_UNIX {
+		path := s.path
+		if path == "" {
+			path = "*"
+		}
+		local = path + " " + strconv.FormatUint(s.inode, 10)
+		peer = "* 0"
+	} else {
+		local = p.addr(s, s.lip, s.lport)
+		peer = p.addr(s, s.rip, s.rport)
+	}
+	r := []string{s.netid, stateName(s.state),
+		strconv.FormatUint(uint64(s.recvQ), 10), strconv.FormatUint(uint64(s.sendQ), 10),
+		local, peer}
+	var extra []string
+	if p.o.procs {
+		if u := p.users[s.inode]; len(u) > 0 && s.inode != 0 {
+			extra = append(extra, "users:("+strings.Join(u, ",")+")")
+		}
+	}
+	if p.o.extended && s.family != unix.AF_UNIX {
+		if s.hasUID {
+			extra = append(extra, fmt.Sprintf("uid:%d", s.uid))
+		}
+		extra = append(extra, fmt.Sprintf("ino:%d", s.inode))
+	}
+	return append(r, strings.Join(extra, " "))
+}
+
+func (p *printer) print(w io.Writer, socks []sock, showNetid bool) {
+	rows := [][]string{}
+	if !p.o.noHeader {
+		rows = append(rows, []string{"Netid", "State", "Recv-Q", "Send-Q",
+			"Local Address:Port", "Peer Address:Port", "Process"})
+	}
+	for i := range socks {
+		rows = append(rows, p.row(&socks[i]))
+	}
+	first := 0
+	if !showNetid {
+		first = 1
+	}
+	width := make([]int, 7)
+	for _, r := range rows {
+		for i, c := range r {
+			width[i] = max(width[i], len(c))
+		}
+	}
+	for _, r := range rows {
+		var b strings.Builder
+		for i := first; i < len(r); i++ {
+			if i > first {
+				b.WriteString(" ")
+			}
+			switch {
+			case i == len(r)-1:
+				b.WriteString(r[i])
+			case i == 2 || i == 3:
+				fmt.Fprintf(&b, "%*s", width[i], r[i])
+			default:
+				fmt.Fprintf(&b, "%-*s", width[i], r[i])
+			}
+		}
+		fmt.Fprintln(w, strings.TrimRight(b.String(), " "))
+	}
+}
