+func TestProcInetTCP6(t *testing.T) {
+	body := inetHeader +
+		fmt.Sprintf("  0: %s %s 0A 00000000:00000000 00:00000000 00000000     0        0 9001 1 0000000000000000 100 0 0 10 0\n",
+			hexAddr(net.IPv6unspecified, 22), hexAddr(net.IPv6unspecified, 0)) +
+		fmt.Sprintf("  1: %s %s 01 00000000:00000000 00:00000000 00000000     0        0 9002 1 0000000000000000 100 0 0 10 0\n",
+			hexAddr(net.ParseIP("fd7a:115c:a1e0::338:f6d"), 60432), hexAddr(net.ParseIP("::ffff:10.0.0.9"), 51000))
+	socks, err := procInet(writeFile(t, "tcp6", body), "tcp", unix.AF_INET6)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := &printer{o: &options{numeric: true}}
+	for i, want := range [][2]string{
+		{"[::]:22", "[::]:*"},
+		{"[fd7a:115c:a1e0::338:f6d]:60432", "[::ffff:10.0.0.9]:51000"},
+	} {
+		got := p.row(&socks[i])
+		if got[4] != want[0] || got[5] != want[1] {
+			t.Errorf("row %d = %q, want local %s peer %s", i, got, want[0], want[1])
+		}
+	}
+	if stateName(socks[0].state) != "LISTEN" {
+		t.Errorf("state = %s", stateName(socks[0].state))
+	}
