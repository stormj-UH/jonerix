+func TestRunFlags(t *testing.T) {
+	var out, errOut strings.Builder
+	if rc := run([]string{"-V"}, &out, &errOut); rc != 0 || !strings.Contains(out.String(), "jonerix-netutils") {
+		t.Errorf("-V: rc=%d out=%q", rc, out.String())
+	}
+	if rc := run([]string{"-tlnq"}, &out, &errOut); rc != 2 {
+		t.Errorf("unknown flag: rc=%d", rc)
+	}
+	if rc := run([]string{"-tln", "sport", "=", ":22"}, &out, &errOut); rc != 1 {
+		t.Errorf("filter expression: rc=%d", rc)
