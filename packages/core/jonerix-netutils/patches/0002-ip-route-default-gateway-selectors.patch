+func cidr(t *testing.T, s string) *net.IPNet {
+	t.Helper()
+	_, n, err := net.ParseCIDR(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return n
+}
+
+func TestIsDefaultDst(t *testing.T) {
+	for s, want := range map[string]bool{
+		"0.0.0.0/0":   true,
+		"::/0":        true,
+		"10.0.0.0/8":  false,
+		"0.0.0.0/32":  false,
+		"fd00::/64":   false,
+		"0.0.0.0/1":   false,
+		"128.0.0.0/1": false,
+	} {
+		if got := isDefaultDst(cidr(t, s)); got != want {
+			t.Errorf("isDefaultDst(%s) = %v", s, got)
+		}
+	}
+	if !isDefaultDst(nil) {
+		t.Errorf("isDefaultDst(nil) = false")
+	}
+}
+
+func TestParsePrefix(t *testing.T) {
+	for in, want := range map[string]string{
+		"10.99.0.0/16": "10.99.0.0/16",
+		"192.0.2.77":   "192.0.2.77/32",
+		"fd01::5":      "fd01::5/128",
+		"fd01::/64":    "fd01::/64",
+	} {
+		got, err := parsePrefix(in)
+		if err != nil || got.String() != want {
+			t.Errorf("parsePrefix(%s) = %v, %v; want %s", in, got, err, want)
+		}
+	}
+	if _, err := parsePrefix("bogus"); err == nil {
+		t.Errorf("parsePrefix(bogus) succeeded")
+	}
+}
