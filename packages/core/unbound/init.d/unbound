#!/bin/openrc-run
# unbound — validating recursive DNSSEC resolver (BSD-3-Clause).
# Part of the jonerix core unbound jpkg.

name="unbound"
description="Validating recursive caching DNS resolver"

: "${UNBOUND_CONF:=/etc/unbound/unbound.conf}"
: "${UNBOUND_PIDFILE:=/run/unbound.pid}"

command="/bin/unbound"
command_args="-c ${UNBOUND_CONF}"
pidfile="${UNBOUND_PIDFILE}"
command_background="no"

depend() {
    # unbound.conf's 'interface:' directive means we need the link up
    # before starting. Order after dhcpcd so /etc/resolv.conf has
    # already been reconciled by the unbound post_install edit (and
    # by any downstream dhcpcd nohook directive).
    need net
    after dhcpcd
    provide dns
    keyword -jail -prefix
}

start_pre() {
    # unbound writes its pidfile while still root, before it chroots
    # and drops to the 'unbound' user, so the directory only has to
    # exist. Never hand it to 'unbound': with the default pidfile that
    # directory is /run itself.
    checkpath -d "$(dirname "${UNBOUND_PIDFILE}")" 2>/dev/null || true
    # unbound keeps its RFC 5011 trust-anchor state in /etc/unbound/db
    # (see unbound.conf.default) and must be able to rewrite it.
    checkpath -d -m 0755 -o unbound:unbound /etc/unbound/db 2>/dev/null || true
    # Fetch (or refresh) each DNSSEC anchor the config tracks.
    # Best-effort: if the network is still coming up, unbound-anchor
    # keeps the file it has, or writes the builtin anchor.
    for _anchor in $(/bin/unbound-checkconf -o auto-trust-anchor-file \
            "${UNBOUND_CONF}" 2>/dev/null); do
        if [ -x /bin/unbound-anchor ]; then
            /bin/unbound-anchor -a "${_anchor}" >/dev/null 2>&1 || true
        fi
        chown unbound:unbound "${_anchor}" 2>/dev/null || true
        # unbound exits on its first RFC 5011 update if it cannot write
        # a temporary file next to the anchor.
        if [ "$(stat -c %U "$(dirname "${_anchor}")" 2>/dev/null)" != unbound ]; then
            ewarn "unbound cannot write next to ${_anchor}; move"
            ewarn "auto-trust-anchor-file into /etc/unbound/db"
        fi
    done
}

start_post() {
    # Confirm the socket is actually bound. A config error that passes
    # syntax but fails at bind time (e.g. port 53 already in use) is
    # otherwise silent because unbound forks off.
    for _ in 1 2 3 4 5; do
        if [ -f "${UNBOUND_PIDFILE}" ]; then return 0; fi
        sleep 1
    done
    eerror "unbound started but did not write ${UNBOUND_PIDFILE}"
    return 1
}

reload() {
    ebegin "Reloading unbound configuration"
    start-stop-daemon --signal HUP --pidfile "${pidfile}"
    eend $?
}
