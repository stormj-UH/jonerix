#!/bin/mksh
# jpkg-conform <release-version> [--nopkgs]
#
# Shebang note: this script REQUIRES mksh, not /bin/sh. On older jonerix
# hosts /bin/sh is toybox sh which (a) rejects `set -e` with "set: bad -e",
# (b) has no `trap` builtin, and (c) has no `command` builtin — every one
# of which this script uses. mksh is a guaranteed runtime dep of jpkg
# (declared in packages/core/jpkg/recipe.toml's [depends].runtime), so
# /bin/mksh is always present anywhere jpkg runs. Hardcoding the path
# rather than relying on /bin/sh sidesteps the broken-toybox-sh class of
# bug that bit `jpkg conform 1.2.1` on jonerix-tormenta 2026-05-03.
#
# Bring this host into conformance with a jonerix release tag.
#
# Given an x.y.z version (e.g. 1.1.6), this reconfigures jpkg's mirror
# to point at that tag's GitHub release, runs `jpkg update` to fetch
# the pinned INDEX.zst, brings jpkg itself up to the pinned version first
# (`jpkg install jpkg` / `jpkg upgrade jpkg`, never --force and never a
# downgrade, so every later step runs with the newest jpkg -- 2.2.11+
# keeps admin-edited config files), and then moves every other package
# that is installed locally AND present in the release to the pinned
# version: `jpkg upgrade <pkg>` when the pin is newer, `jpkg install
# --force <pkg>` when it is older.  Then it restores the mirror config,
# refreshes the INDEX, and -- only when every package conformed -- writes
# the matching /etc/os-release.
#
# Packages installed locally but not in the release are left alone.
# Packages in the release but not installed are NOT auto-installed.
#
# --nopkgs       Skip the mirror-swap + package conformance; only
#                install the matching /etc/os-release.
#
# Invoked as either `jpkg conform <ver>` (via jpkg's fallthrough to
# jpkg-<name> external subcommands, see main.c) or directly as
# `jpkg-conform <ver>`. mksh-compatible (POSIX + a few mksh extras like
# `set -eu`, `trap`, and `command -v` that toybox sh lacks). No bash arrays,
# brace expansion, or process substitution — those would still need brash.
# No awk either (jpkg does not depend on one): the INDEX and metadata are
# read with sh and sed.
#
# Part of jpkg (0BSD, jonerix core jpkg).

set -eu

REPO="stormj-UH/jonerix"
RELEASE_BASE="https://github.com/${REPO}/releases/download"
RAW_BASE="https://raw.githubusercontent.com/${REPO}"

# ---------------- argument parsing ----------------

usage() {
    cat <<EOF
Usage: jpkg conform <release-version> [--nopkgs]

Bring installed packages and /etc/os-release into line with a pinned
jonerix release (e.g. 1.1.6 -> the v1.1.6 GitHub release).

  <release-version>   x.y.z or vx.y.z (the leading 'v' is optional)

Options:
  --nopkgs            Update /etc/os-release only; leave packages alone.
  -h, --help          Show this help.
EOF
}

VERSION=""
NOPKGS=0
for arg in "$@"; do
    case "$arg" in
        --nopkgs) NOPKGS=1 ;;
        -h|--help) usage; exit 0 ;;
        -*)
            printf 'jpkg-conform: unknown option: %s\n' "$arg" >&2
            usage >&2
            exit 2 ;;
        *)
            if [ -n "$VERSION" ]; then
                printf 'jpkg-conform: unexpected extra argument: %s\n' "$arg" >&2
                exit 2
            fi
            VERSION="$arg"
            ;;
    esac
done

if [ -z "$VERSION" ]; then
    usage >&2
    exit 2
fi

# Normalise "1.1.6" / "v1.1.6" -> BARE=1.1.6, TAG=v1.1.6.
BARE="${VERSION#v}"
TAG="v${BARE}"

# Basic shape check (x.y.z with numeric components). Accept -rN tails
# even though the distro version itself should never have -r, since
# future schemes might.
case "$BARE" in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *)
        printf 'jpkg-conform: version must be x.y.z, got: %s\n' "$VERSION" >&2
        exit 2 ;;
esac

# ---------------- helpers ----------------

# Resolve the rootfs for edits. We DON'T honour JPKG_ROOT here — conform
# is always acting on the live host. Cross-root conforms can be done
# with `jpkg -r /mnt conform ...` via main.c's --root handling once the
# built-in command lands; until then, this script is host-only.
ROOTFS=""

jpkg_cache="${ROOTFS}/var/cache/jpkg"
jpkg_conf="${ROOTFS}/etc/jpkg/repos.conf"
os_release="${ROOTFS}/etc/os-release"
db_installed="${ROOTFS}/var/db/jpkg/installed"

TMPDIR=$(mktemp -d /tmp/jpkg-conform.XXXXXX)
trap '_rc=$?; rm -rf "$TMPDIR"; exit $_rc' EXIT
# A hangup or interrupt must still run the EXIT trap (which restores the
# mirror config once it is swapped), so turn signals into exits.  The EXIT
# traps end in `exit $_rc`: mksh would otherwise exit with the status of
# the trap's last command, and an interrupted conform would report success.
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Pick a downloader. curl is in core; wget generally isn't.
if command -v curl >/dev/null 2>&1; then
    fetch() { curl -fsSL --retry 3 -o "$2" "$1"; }
else
    printf 'jpkg-conform: curl not found — cannot fetch release assets\n' >&2
    exit 1
fi

# Decide the arch label the release uses. jpkg's INDEX has sections
# like [name-<arch>] with arch in {aarch64, x86_64}.
case "$(uname -m)" in
    aarch64|arm64)    ARCH=aarch64 ;;
    x86_64|amd64)     ARCH=x86_64 ;;
    *)
        printf 'jpkg-conform: unsupported arch: %s\n' "$(uname -m)" >&2
        exit 1 ;;
esac

# ---------------- step 1: fetch /etc/os-release ----------------
#
# Primary source: the os-release file that was committed at the release
# tag. Fallback: synthesise a minimal one from the version string. It is
# installed (with a backup of the pre-existing file at
# /etc/os-release.pre-conform.<ver>) right away for --nopkgs, otherwise
# only after every package conformed, so a host is never labelled with a
# release it did not reach.
osr_src="$TMPDIR/os-release"
osr_url="${RAW_BASE}/${TAG}/config/defaults/etc/os-release"
if fetch "$osr_url" "$osr_src" 2>/dev/null; then
    printf 'jpkg-conform: fetched os-release for %s from git tag\n' "$TAG"
else
    printf 'jpkg-conform: git tag fetch failed; synthesising os-release\n' >&2
    cat > "$osr_src" <<EOF
NAME="jonerix"
ID=jonerix
VERSION_ID=${BARE}
PRETTY_NAME="jonerix ${BARE}"
HOME_URL="https://github.com/${REPO}"
BUG_REPORT_URL="https://github.com/${REPO}/issues"
EOF
fi
install_os_release() {
    if [ -f "$os_release" ]; then
        cp "$os_release" "${os_release}.pre-conform.${BARE}" 2>/dev/null || true
    fi
    install -Dm644 "$osr_src" "$os_release"
    printf 'jpkg-conform: installed %s\n' "$os_release"
}

# ---------------- short-circuit for --nopkgs ----------------
if [ "$NOPKGS" -eq 1 ]; then
    install_os_release
    printf 'jpkg-conform: --nopkgs set; package conformance skipped\n'
    exit 0
fi

# ---------------- step 2: swap the mirror to the release ----------------
#
# Point jpkg at the release URL, refresh the index so we see the pinned
# versions, and remember to put the old config back on exit whether
# conform succeeds or fails.

orig_conf=""
if [ -f "$jpkg_conf" ]; then
    orig_conf="${jpkg_conf}.pre-conform.$$"
    cp "$jpkg_conf" "$orig_conf"
fi
restore_conf() {
    if [ -n "$orig_conf" ] && [ -f "$orig_conf" ]; then
        mv "$orig_conf" "$jpkg_conf"
    else
        rm -f "$jpkg_conf"
    fi
    # Refresh the index against the restored mirror so subsequent
    # jpkg commands on this host don't keep seeing the release-pinned
    # INDEX. We swallow failures — the conform itself may have
    # succeeded even if the final update hits a transient network
    # hiccup; the user can always `jpkg update` manually.
    jpkg update >/dev/null 2>&1 || true
}
trap '_rc=$?; rm -rf "$TMPDIR"; restore_conf; exit $_rc' EXIT

mkdir -p "$(dirname "$jpkg_conf")"
cat > "$jpkg_conf" <<EOF
# temporary jpkg mirror config written by jpkg-conform for ${TAG}
# on $(date -u +%Y-%m-%dT%H:%M:%SZ). The original is at:
#   ${orig_conf:-<none - jpkg was using its built-in default>}
# jpkg-conform restores it on exit.
[repo]
url = "${RELEASE_BASE}/${TAG}"
EOF

# Clear any stale INDEX cache pointing at the prior mirror, AND every
# previously-downloaded *.jpkg blob. Defense in depth: jpkg 2.0.2+
# auto-recovers from cache-vs-INDEX sha256 mismatches by deleting the
# bad blob and re-fetching, but on older jpkg the rolling-vs-tagged
# filename collision (same name, different bytes when a package was
# rebuilt between releases) is a fatal "sha256 mismatch" error. Purging
# the cache here costs one rm at mirror-swap time and unblocks
# pre-2.0.2 jpkg builds. Reproduced 2026-05-03 jpkg conform 1.2.1.
rm -f "${jpkg_cache}/INDEX" "${jpkg_cache}/INDEX.zst" \
      "${jpkg_cache}/INDEX.zst.sig" \
      "${jpkg_cache}"/*.jpkg

printf 'jpkg-conform: pointing jpkg at %s/%s\n' "$RELEASE_BASE" "$TAG"
jpkg update

# ---------------- step 3: parse INDEX, find installed drift ----------------

index_file="${jpkg_cache}/INDEX"
if [ ! -s "$index_file" ]; then
    # Some jpkg builds only cache INDEX.zst; decompress on demand.
    if [ -s "${jpkg_cache}/INDEX.zst" ]; then
        zstd -qdc "${jpkg_cache}/INDEX.zst" > "$index_file"
    else
        printf 'jpkg-conform: no INDEX found after update\n' >&2
        exit 1
    fi
fi

# Walk [name-arch] sections and emit "name<TAB>version" for our arch.  The
# package name may itself contain dashes (jonerix-raspi5-fixups), so only
# the trailing "-<arch>" is stripped.
pinned_list="$TMPDIR/pinned.tsv"
_tab=$(printf '\t')
pkg=""
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        "["*"]")
            sec=${line#\[}
            sec=${sec%\]}
            case "$sec" in
                *-"$ARCH") pkg=${sec%-"$ARCH"} ;;
                *) pkg="" ;;
            esac
            ;;
        "version = \""*)
            if [ -n "$pkg" ]; then
                ver=${line#*\"}
                ver=${ver%%\"*}
                printf '%s%s%s\n' "$pkg" "$_tab" "$ver"
                pkg=""
            fi
            ;;
    esac
done < "$index_file" > "$pinned_list"
pinned_count=$(wc -l < "$pinned_list")
printf 'jpkg-conform: %d package(s) pinned for %s in %s INDEX\n' \
    "$pinned_count" "$ARCH" "$TAG"

# ---------------- step 4: compare to installed and conform ----------------
installed_version() {
    # Read the installed version straight from the on-disk metadata (no
    # per-package jpkg call, which would pay the lock + INDEX load each).
    _m="${db_installed}/$1/metadata.toml"
    [ -f "$_m" ] || return 0
    sed -n '/^[[:space:]]*version[[:space:]]*=/{s/^[^"]*"\([^"]*\)".*/\1/p;q;}' "$_m" 2>/dev/null
}
pinned_version() {
    while IFS="$_tab" read -r _p _v; do
        [ "$_p" = "$1" ] && { printf '%s\n' "$_v"; return 0; }
    done < "$pinned_list"
    return 0
}

drift=0
fixed=0
failed=0
jpkg_rc=0

# jpkg first, on its own.  Everything after this runs with the pinned (or
# newer) jpkg -- never `install --force jpkg`, which would make the old
# jpkg reinstall its whole runtime closure without config protection, and
# never a downgrade of jpkg itself.  If that step fails, stop: the old jpkg
# must not go on to conform the rest.
jpkg_pin=$(pinned_version jpkg)
jpkg_have=$(installed_version jpkg)
if [ -n "$jpkg_pin" ] && [ "$jpkg_have" != "$jpkg_pin" ]; then
    drift=$((drift + 1))
    printf 'jpkg-conform: drift: jpkg installed=%s pinned=%s (handled first)\n' \
        "${jpkg_have:-<not registered>}" "$jpkg_pin"
    if [ -z "$jpkg_have" ]; then
        jpkg install jpkg || jpkg_rc=$?
    else
        jpkg upgrade jpkg || jpkg_rc=$?
    fi
    if [ "$jpkg_rc" -ne 0 ]; then
        printf 'jpkg-conform: updating jpkg itself failed (exit %s); nothing else was conformed and /etc/os-release was left as it was\n' \
            "$jpkg_rc" >&2
        exit 1
    fi
    jpkg_now=$(installed_version jpkg)
    if [ "$jpkg_now" = "$jpkg_pin" ]; then
        fixed=$((fixed + 1))
    else
        printf 'jpkg-conform: jpkg stays at %s (the release pins %s; jpkg is never downgraded)\n' \
            "${jpkg_now:-<not registered>}" "$jpkg_pin" >&2
    fi
fi

# Read-from-file pattern keeps us portable across mksh/busybox/toybox —
# `while read; do ...; done < file` avoids the subshell trap that bites
# `cmd | while read`.
while IFS="$_tab" read -r pkg pinned_ver; do
    [ -n "$pkg" ] || continue
    [ "$pkg" = jpkg ] && continue
    installed_ver=$(installed_version "$pkg")
    [ -n "$installed_ver" ] || continue
    [ "$installed_ver" = "$pinned_ver" ] && continue
    drift=$((drift + 1))
    printf 'jpkg-conform: drift: %s installed=%s pinned=%s\n' \
        "$pkg" "$installed_ver" "$pinned_ver"
    # A newer pin: a plain upgrade of this package alone.  Still off (an
    # older pin): reinstall the pinned version.
    jpkg upgrade "$pkg" || true
    if [ "$(installed_version "$pkg")" != "$pinned_ver" ]; then
        jpkg install --force "$pkg" || true
    fi
    if [ "$(installed_version "$pkg")" = "$pinned_ver" ]; then
        fixed=$((fixed + 1))
    else
        failed=$((failed + 1))
        printf 'jpkg-conform: WARN: conforming %s failed — continuing\n' \
            "$pkg" >&2
    fi
done < "$pinned_list"

# ---------------- step 5: summary ----------------

printf '\n'
printf 'jpkg-conform: summary for %s (%s)\n' "$TAG" "$ARCH"
printf '  pinned in release : %s\n' "$pinned_count"
printf '  drift from pinned : %s\n' "$drift"
printf '  conformed         : %s\n' "$fixed"
printf '  failed            : %s\n' "$failed"

if [ "$failed" -gt 0 ]; then
    printf 'jpkg-conform: /etc/os-release left as it was (not every package conformed)\n' >&2
    exit 1
fi
install_os_release
exit 0
