+// Is option NAME (NLEN bytes, maybe with =value) in comma separated OPTS?
+static int mount_hasopt(char *opts, char *name, int nlen)
+{
+  char *s;
+  int len;
+
+  while ((s = comma_iterate(&opts, &len)))
+    if (len>=nlen && !strncmp(s, name, nlen) && (len==nlen || s[nlen]=='='))
+      return 1;
+
+  return 0;
+}
+
+// util-linux -O semantics: every item in WANT must match OPTS. "noOPT"
+// matches entries without OPT (OpenRC's localmount runs "mount -a -O
+// no_netdev" to skip _netdev entries), "+OPT" matches OPT literally, and
+// anything else must be present.
+static int mount_Omatch(char *opts, char *want)
+{
+  char *s;
+  int len, no;
+
+  while ((s = comma_iterate(&want, &len))) {
+    no = 0;
+    if (*s == '+') s++, len--;
+    else if (len>2 && !strncmp(s, "no", 2)) no = 1, s += 2, len -= 2;
+    if (mount_hasopt(opts, s, len) == no) return 0;
+  }
+
+  return 1;
 }
 
+// Is fstab entry MM already mounted as /proc/mounts entry MMM? Same
+// directory, then same device by name or by device number: the kernel calls
+// a root it mounted itself "/dev/root", and fstab may say UUID= and so on.
+// "/" is always mounted by the time mount -a runs.
+static int mount_already(struct mtab_list *mm, struct mtab_list *mmm)
+{
+  struct stat st;
+  char *dev;
+  int same;
+
+  if (strcmp(mm->dir, mmm->dir)) return 0;
+  if (!strcmp(mm->dir, "/") || !strcmp(mm->device, mmm->device)) return 1;
+  if (!(dev = mount_resolve(mm->device))) return 0;
+  same = !stat(dev, &st) && S_ISBLK(st.st_mode)
+    && st.st_rdev == mmm->stat.st_dev;
+  if (dev != mm->device) free(dev);
+
+  return same;
+}
