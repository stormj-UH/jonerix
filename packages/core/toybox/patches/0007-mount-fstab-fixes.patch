+// Copy KEY's value out of sysfs uevent text UE into OUT (LEN bytes).
+static char *mount_ueget(char *ue, char *key, char *out, int len)
+{
+  int klen = strlen(key), i;
+  char *s = ue;
+
+  while (s && *s) {
+    if (!strncmp(s, key, klen) && s[klen] == '=') {
+      for (s += klen+1, i = 0; i<len-1 && s[i] && s[i] != '\n'; i++)
+        out[i] = s[i];
+      out[i] = 0;
+
+      return out;
+    }
+    if ((s = strchr(s, '\n'))) s++;
+  }
+
+  return 0;
+}
+
+// Write the PARTUUID of partition PART of whole disk DISK into OUT (37+
+// bytes): the MBR disk signature plus partition number ("1234abcd-02"),
+// or the GPT unique partition GUID. Returns 0 if there's no such table.
+static int mount_partuuid(char *disk, int part, char *out)
+{
+  char buf[512], *s = xmprintf("/dev/%s", disk);
+  int fd = open(s, O_RDONLY), ss = 512, gpt = 0, rc = 0, i;
+  long long lba, cnt, esz;
+
+  free(s);
+  if (fd == -1) return 0;
+  if (ioctl(fd, BLKSSZGET, &ss) || ss<512 || ss>65536) ss = 512;
+  if (512 == pread(fd, buf, 512, 0) && buf[510] == 0x55
+      && (buf[511]&255) == 0xaa)
+  {
+    for (i = 0; i<4; i++) if ((buf[446+16*i+4]&255) == 0xee) gpt++;
+    if (!gpt) {
+      sprintf(out, "%08x-%02x", (unsigned)peek_le(buf+440, 4), part);
+      rc = 1;
+    } else if (92 == pread(fd, buf, 92, ss) && !memcmp(buf, "EFI PART", 8)) {
+      lba = peek_le(buf+72, 8);
+      cnt = peek_le(buf+80, 4);
+      esz = peek_le(buf+84, 4);
+      // Unique partition GUID is at +16; its first 3 fields are little endian
+      if (part<=cnt && esz>=128 && esz<=4096
+          && 16 == pread(fd, buf, 16, lba*ss+(part-1)*esz+16))
+      {
+        sprintf(out, "%08x-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+          (unsigned)peek_le(buf, 4), (unsigned)peek_le(buf+4, 2),
+          (unsigned)peek_le(buf+6, 2), buf[8]&255, buf[9]&255, buf[10]&255,
+          buf[11]&255, buf[12]&255, buf[13]&255, buf[14]&255, buf[15]&255);
+        // an all zero GUID is an unused entry
+        rc = strspn(out, "0-") != strlen(out);
+      }
+    }
+  }
+  close(fd);
+
+  return rc;
+}
+
+// Find the partition with PARTUUID (or with GPT name PARTLABEL, which the
+// kernel exports as PARTNAME) WANT. Without udev there's no
+// /dev/disk/by-partuuid, so walk /sys/class/block and read partition tables.
+static char *mount_findpart(char *want, int label)
+{
+  DIR *dp = opendir("/sys/class/block");
+  struct dirent *de;
+  char *found = 0, *s, ue[1024], name[256], disk[256], val[80];
+  int part;
+
+  while (dp && !found && (de = readdir(dp))) {
+    if (*de->d_name == '.') continue;
+    s = xmprintf("/sys/class/block/%s/uevent", de->d_name);
+    if (!readfile(s, ue, sizeof(ue))) *ue = 0;
+    free(s);
+    if (!mount_ueget(ue, "PARTN", val, sizeof(val)) || (part = atoi(val))<1
+        || !mount_ueget(ue, "DEVNAME", name, sizeof(name))) continue;
+    if (label) {
+      if (!mount_ueget(ue, "PARTNAME", val, sizeof(val)) || strcmp(val, want))
+        continue;
+    } else {
+      // A partition's parent directory in sysfs is its whole disk.
+      s = xmprintf("/sys/class/block/%s/../uevent", de->d_name);
+      if (!readfile(s, ue, sizeof(ue))) *ue = 0;
+      free(s);
+      if (!mount_ueget(ue, "DEVNAME", disk, sizeof(disk))
+          || !mount_partuuid(disk, part, val) || strcasecmp(val, want))
+        continue;
+    }
+    found = xmprintf("/dev/%s", name);
+  }
+  if (dp) closedir(dp);
+
+  return found;
+}
