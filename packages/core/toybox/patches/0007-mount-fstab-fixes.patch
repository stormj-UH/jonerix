+// Turn UUID=, LABEL=, PARTUUID= or PARTLABEL= into a device path. Returns
+// DEV itself if it's none of those, else a malloced path, or 0 if not found.
+static char *mount_resolve(char *dev)
+{
+  char *s = dev, *flag;
+
+  if (strstart(&s, "UUID=")) flag = "-U";
+  else if (strstart(&s, "LABEL=")) flag = "-L";
+  else if (strstart(&s, "PARTUUID=")) return mount_findpart(s, 0);
+  else if (strstart(&s, "PARTLABEL=")) return mount_findpart(s, 1);
+  else return dev;
+  // toybox's own blkid: the one on $PATH may lack -U/-L (reforger's does)
+  s = chomp(xrunread((char *[]){"toybox", "blkid", flag, s, 0}, 0));
+  if (s && !*s) {
+    free(s);
+    s = 0;
+  }
+
+  return s;
 }
 
