#!/bin/openrc-run
# hwclock (jonerix-raspi5-fixups fallback copy)
#
# /etc/init.d/hwclock belongs to the openrc package. raspi5-fixups up to
# 1.6.32 also shipped it, so a jpkg that still deletes files dropped from a
# package's manifest removes openrc's script when fixups upgrades to 1.6.33.
# post_install copies this file into place ONLY when /etc/init.d/hwclock is
# missing afterwards; it never replaces an existing script. It avoids
# --systz, which jonerix-util's hwclock rejects.

extra_commands="save show"

description="Synchronize the system clock with the hardware clock."
description_save="Save the current system time to the RTC."
description_show="Display the current RTC time."

: ${clock_args:=${CLOCK_OPTS}}
: ${clock_systohc:=${CLOCK_SYSTOHC}}

depend()
{
    provide clock
    want modules
    keyword -docker -lxc -openvz -prefix -systemd-nspawn -uml -vserver -xenu
}

rtc_exists()
{
    local rtc=
    for rtc in /dev/rtc /dev/rtc[0-9]*; do
        [ -e "$rtc" ] && break
    done
    [ -e "$rtc" ]
}

_hwclock()
{
    local err=
    err="$(hwclock "$@" 2>&1 >/dev/null)"
    [ -z "$err" ] && return 0
    echo "$err" >&2
    return 1
}

start()
{
    local retval=0 modname=

    ebegin "Setting system clock using the hardware clock"
    if [ -e /proc/modules ]; then
        if ! rtc_exists; then
            for x in rtc-cmos rtc genrtc; do
                modprobe -q "$x" && rtc_exists && modname="$x" && break
            done
            [ -n "$modname" ] &&
                ewarn "The $modname module needs to be configured in" \
                    "${RC_SERVICE%/*/*}/conf.d/modules or built in."
        fi
    fi

    if yesno ${clock_hctosys:-YES}; then
        _hwclock --hctosys $clock_args
        retval=$?
    fi

    eend $retval "Failed to set the system clock"
    return 0
}

stop()
{
    [ -n "$CDBOOT" ] && return 0
    yesno ${clock_systohc:-YES} || return 0

    ebegin "Setting hardware clock using the system clock"
    _hwclock --systohc $clock_args
    eend $? "Failed to sync clocks"
}

save()
{
    clock_systohc=yes
    stop
}

show()
{
    hwclock --show $clock_args
}
