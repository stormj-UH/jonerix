#!/bin/openrc-run
# reboot-trace-shutdown — write /var/log/reboot-trace/shutdown-*.log on the
# way down. boot-trace compares the boot id recorded here with the one in
# the previous boot trace to tell a clean shutdown from an unclean reset.
#
# Part of jonerix-raspi5-fixups — MIT License

name="reboot-trace-shutdown"
description="Capture shutdown diagnostics before reboot"

: "${keep:=50}"

depend() {
    before killprocs savecache mount-ro
}

# Same retention rule as boot-trace: keep the newest $keep shutdown traces
# (globs expand sorted and the names embed a UTC timestamp).
_prune_shutdown_traces() {
    local d n keep1 f
    d=$1
    case "$keep" in ''|*[!0-9]*) return 0 ;; esac
    set -- "$d"/shutdown-*.log
    [ -e "$1" ] || return 0
    n=$(($# - keep))
    [ "$n" -gt 0 ] || return 0
    keep1=$(readlink "$d/latest-shutdown.log" 2>/dev/null)
    for f in "$@"; do
        [ "$n" -gt 0 ] || break
        n=$((n - 1))
        [ "${f##*/}" = "$keep1" ] && continue
        rm -f "$f"
    done
}

start() {
    local dir log base
    dir=/var/log/reboot-trace
    mkdir -p "$dir"
    base="shutdown-$(date -u +%Y%m%dT%H%M%SZ)-$(cut -d. -f1 /proc/uptime 2>/dev/null).log"
    log="$dir/$base"

    ebegin "Capturing shutdown trace"
    {
        echo "=== shutdown trace ==="
        date -u
        echo
        echo "[boot id]"
        cat /proc/sys/kernel/random/boot_id 2>/dev/null || true
        echo
        echo "[uptime]"
        cat /proc/uptime 2>/dev/null || true
        echo
        echo "[cmdline]"
        cat /proc/cmdline 2>/dev/null || true
        echo
        echo "[reboot mode (configured)]"
        cat /sys/kernel/reboot/mode 2>/dev/null || true
        echo
        echo "[throttled]"
        if [ -x /bin/pi5-fw ]; then
            /bin/pi5-fw get_throttled 2>&1 || true
        else
            echo "pi5-fw not installed"
        fi
        echo
        echo "[rc-status]"
        rc-status -a 2>&1 || true
        echo
        echo "[processes]"
        # toybox ps with no selection lists only processes on stdin's tty,
        # and at shutdown stdin is the console, so it printed nothing but
        # the header. Select every process explicitly; </dev/null keeps the
        # tty filter from ever applying.
        # shellcheck disable=SC2217
        ps -A -o pid,ppid,user,args </dev/null 2>&1 || true
        echo
        echo "[mounts]"
        cat /proc/mounts 2>/dev/null || true
        echo
        echo "[open files under root-ish paths]"
        for pid in /proc/[0-9]*; do
            [ -d "$pid/fd" ] || continue
            p=${pid##*/}
            for fd in "$pid"/fd/*; do
                target=$(readlink "$fd" 2>/dev/null) || continue
                case "$target" in
                    /var/*|/etc/*|/home/*|/root/*)
                        printf 'pid=%s fd=%s target=%s cmd=' "$p" "${fd##*/}" "$target"
                        tr '\0' ' ' < "$pid/cmdline" 2>/dev/null
                        printf '\n'
                        break
                        ;;
                esac
            done
        done
        echo
        echo "[dmesg]"
        dmesg 2>&1 || true
    } > "$log" 2>&1
    ln -sf "$base" "$dir/latest-shutdown.log"
    _prune_shutdown_traces "$dir"
    sync
    eend 0
}
